# Copy to .env.local and fill in from Supabase: Project Settings > API (or Connect).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...). A legacy anon key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Used to build links in auth emails. Defaults to the request host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Shown on /contact when set.
NEXT_PUBLIC_CONTACT_EMAIL=

# Server only. Project Settings > API Keys > secret key. Saves investigations and service records.
SUPABASE_SECRET_KEY=

# Optional, server only. Enables "Read aloud" evidence narration through ElevenLabs.
ELEVENLABS_API_KEY=
# Optional. Defaults to a neutral narrator voice; set your own voice ID to change it.
ELEVENLABS_VOICE_ID=

# Optional. Character voices use fixed ElevenLabs library voices (see src/cases/C001/characters.ts).
# To recast one, set ELEVENLABS_VOICE_<CHARACTER ID>, for example:
# ELEVENLABS_VOICE_MARGARET=
# ELEVENLABS_VOICE_DANIEL=
# ELEVENLABS_VOICE_ROBERT=
# ELEVENLABS_VOICE_PATRICIA=
# ELEVENLABS_VOICE_BENNETT=
# ELEVENLABS_VOICE_ROSA=

# Optional, server only. Lets interviewees understand any phrasing and answer in their own words
# from their knowledge sets (src/cases/C001/knowledge.ts). Without it, questions are matched to the
# authored answers by a built-in matcher, and anything it cannot place gets an in-character "I don't know".
ANTHROPIC_API_KEY=
# Only for a key not scoped to a workspace (Anthropic Console, Settings, Workspaces): the workspace ID.
ANTHROPIC_WORKSPACE_ID=
# Optional. The model used for interviews. Defaults to claude-haiku-5-5 (fast and inexpensive).
INTERVIEW_MODEL=

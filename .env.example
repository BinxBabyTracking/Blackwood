# Copy to .env.local and fill in from Supabase: Project Settings > API (or Connect).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...). A legacy anon key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Used to build links in auth emails. Defaults to the request host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Shown on /contact when set.
NEXT_PUBLIC_CONTACT_EMAIL=

# Server only. Project Settings > API Keys > secret key. Saves investigations and service records.
SUPABASE_SECRET_KEY=
